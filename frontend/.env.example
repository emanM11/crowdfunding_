VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Stripe PaymentIntents: public (publishable) key for client-side card
# tokenization. Leave blank to run the offline sandbox checkout — the
# backend must be set to PAYMENT_GATEWAY=stripe + STRIPE_SECRET_KEY for
# real charges (see backend/.env).
VITE_STRIPE_PUBLIC_KEY=

# Bonus: Facebook login — leave blank to keep the button disabled
VITE_FACEBOOK_APP_ID=
