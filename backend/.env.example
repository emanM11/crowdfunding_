# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL
DB_NAME=crowdfunding_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS - React dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend base URL (used to build activation / password-reset links)
FRONTEND_URL=http://localhost:5173

# Payment gateway — 'mock' runs an offline Stripe-test-mode-style sandbox
# (no keys needed). For real Stripe test-mode charges:
#   PAYMENT_GATEWAY=stripe
#   STRIPE_SECRET_KEY=sk_test_...       (backend — charges via PaymentIntents)
#   STRIPE_WEBHOOK_SECRET=whsec_...     (backend — verifies webhook events)
# and in the FRONTEND .env:
#   VITE_STRIPE_PUBLIC_KEY=pk_test_...  (browser — tokenizes the card via Elements)
PAYMENT_GATEWAY=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Bonus: Facebook login — leave blank to keep the feature disabled
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Email — Gmail SMTP by default. While DEBUG=True with an empty
# EMAIL_HOST_USER, Django falls back to the console backend (emails +
# every link print to the runserver terminal). Fill the two fields below
# with a real Gmail App Password to send actual emails.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL='تكاتف <YOUR_GMAIL_ADDRESS>'
